{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TASK.schema.json",
  "title": "Alpha Miner brain task handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "scope",
    "allowed_paths",
    "acceptance_criteria",
    "prohibitions",
    "round"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "prohibitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failed_acceptance_items",
        "evidence",
        "revision_scope"
      ],
      "properties": {
        "failed_acceptance_items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "revision_scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
